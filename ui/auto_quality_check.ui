 <class>SeAutoQualityCheckDialog</class>
 <widget class="QDialog" name="SeAutoQualityCheckDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>920</width><height>600</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>820</width><height>520</height></size>
  </property>
  <property name="windowTitle">
   <string>综合成果自动化质检</string>
  </property>
  <property name="styleSheet">
   <string>QGroupBox { font-weight: bold; margin-top: 6px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; padding: 0 4px; }
QTabWidget::pane { border: 1px solid #bbb; }
QTabBar::tab { padding: 6px 12px; font-weight: bold; min-width: 70px; }
QTabBar::tab:selected { background: #fff; border-bottom: 2px solid #0078d7; }
QPushButton { padding: 4px 12px; }
QCheckBox { padding: 3px 4px; spacing: 4px; }</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>6</number></property>
   <property name="leftMargin"><number>10</number></property>
   <property name="rightMargin"><number>10</number></property>
   <property name="topMargin"><number>10</number></property>
   <property name="bottomMargin"><number>10</number></property>
   <!-- ====== 数据源 ====== -->
   <item>
    <widget class="QGroupBox" name="groupBox_DataSource">
     <property name="title"><string>数据源</string></property>
     <layout class="QGridLayout" name="gridLayout_DataSource">
      <item row="0" column="0">
       <widget class="QLabel" name="label_OrigData"><property name="text"><string>原始数据路径：</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="lineEdit_OrigDataPath">
        <property name="placeholderText"><string>选择原始数据目录（综合前SHP）</string></property></widget>
      </item>
      <item row="0" column="2">
       <widget class="QPushButton" name="btn_BrowseOrigData"><property name="text"><string>浏览...</string></property></widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_ResultData"><property name="text"><string>成果数据路径：</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="lineEdit_ResultDataPath">
        <property name="placeholderText"><string>选择成果数据目录（综合后SHP）</string></property></widget>
      </item>
      <item row="1" column="2">
       <widget class="QPushButton" name="btn_BrowseResultData"><property name="text"><string>浏览...</string></property></widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_MissionXml"><property name="text"><string>Mission XML：</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="lineEdit_MissionXml">
        <property name="placeholderText"><string>mission_config.xml（自动加载）</string></property></widget>
      </item>
      <item row="2" column="2">
       <widget class="QPushButton" name="btn_BrowseMissionXml"><property name="text"><string>浏览...</string></property></widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="label_MappingConfig"><property name="text"><string>字段映射表：</string></property></widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="lineEdit_MappingConfig">
        <property name="placeholderText"><string>字段映射表CSV（自动加载）</string></property></widget>
      </item>
      <item row="3" column="2">
       <layout class="QHBoxLayout" name="hLayout_MappingBtns">
        <item><widget class="QPushButton" name="btn_BrowseMapping"><property name="text"><string>浏览</string></property><property name="maximumWidth"><number>60</number></property></widget></item>
        <item><widget class="QPushButton" name="btn_ConfigMapping"><property name="text"><string>配置</string></property><property name="maximumWidth"><number>60</number></property></widget></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <!-- ====== 检查项（QTabWidget 由代码填充） ====== -->
   <item>
    <widget class="QGroupBox" name="groupBox_Missions">
     <property name="title"><string>检查项</string></property>
     <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>1</horstretch><verstretch>4</verstretch></sizepolicy></property>
     <layout class="QVBoxLayout" name="missionsLayout">
      <property name="spacing"><number>0</number></property>
      <property name="leftMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
