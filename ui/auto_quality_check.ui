   <!-- ====== 阈值参数 ====== -->
   <item>
    <widget class="QGroupBox" name="groupBox_Params">
     <property name="title"><string>阈值参数</string></property>
     <layout class="QGridLayout" name="gridLayout_Params">
      <item row="0" column="0"><widget class="QLabel" name="label_Scale"><property name="text"><string>比例尺：</string></property></widget></item>
      <item row="0" column="1"><widget class="QSpinBox" name="spinBox_Scale"><property name="minimum"><number>500</number></property><property name="maximum"><number>1000000</number></property><property name="value"><number>10000</number></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="label_Tolerance"><property name="text"><string>结点容差(m)：</string></property></widget></item>
      <item row="0" column="3"><widget class="QDoubleSpinBox" name="doubleSpinBox_Tolerance"><property name="decimals"><number>6</number></property><property name="minimum"><double>0.000001</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>0.001000</double></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="label_AcuteAngle"><property name="text"><string>尖锐角(°)：</string></property></widget></item>
      <item row="1" column="1"><widget class="QDoubleSpinBox" name="doubleSpinBox_AcuteAngle"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.1</double></property><property name="maximum"><double>180.0</double></property><property name="value"><double>10.0</double></property></widget></item>
      <item row="1" column="2"><widget class="QLabel" name="label_SliverArea"><property name="text"><string>碎面面积：</string></property></widget></item>
      <item row="1" column="3"><widget class="QDoubleSpinBox" name="doubleSpinBox_SliverArea"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>100000.0</double></property><property name="value"><double>1.00</double></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="label_NarrowWidth"><property name="text"><string>狭长面宽度(m)：</string></property></widget></item>
      <item row="2" column="1"><widget class="QDoubleSpinBox" name="doubleSpinBox_NarrowWidth"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1000.0</double></property><property name="value"><double>0.50</double></property></widget></item>
      <item row="2" column="2"><widget class="QLabel" name="label_MinArea"><property name="text"><string>小面积：</string></property></widget></item>
      <item row="2" column="3"><widget class="QDoubleSpinBox" name="doubleSpinBox_MinArea"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>100000.0</double></property><property name="value"><double>1.00</double></property></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="label_MinNodeDist"><property name="text"><string>节点最小距离(m)：</string></property></widget></item>
      <item row="3" column="1"><widget class="QDoubleSpinBox" name="doubleSpinBox_MinNodeDist"><property name="decimals"><number>6</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>100.0</double></property><property name="value"><double>0.001000</double></property></widget></item>
     </layout>
    </widget>
   </item>
   <!-- ====== 输出 ====== -->
   <item>
    <widget class="QGroupBox" name="groupBox_Output">
     <property name="title"><string>输出设置</string></property>
     <layout class="QHBoxLayout" name="gridLayout_Output">
      <item><widget class="QLabel" name="label_OutputDir"><property name="text"><string>输出目录：</string></property></widget></item>
      <item><widget class="QLineEdit" name="lineEdit_OutputDir"><property name="placeholderText"><string>质检结果SHP和JSON日志输出目录</string></property></widget></item>
      <item><widget class="QPushButton" name="btn_BrowseOutputDir"><property name="text"><string>浏览...</string></property></widget></item>
